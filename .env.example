# ---- Search, ranking and writing (Claude Sonnet 5.5 and Haiku 5.5)
ANTHROPIC_API_KEY=

# ---- Supabase: accounts, per user state, waitlist, contact form
# Project settings > API. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Writes waitlist and contact_messages. Never exposed to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Optional
# Shown on the contact page and section when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# Server side image generation route. Browser rendering uses the key pasted in Profile.
GOOGLE_AI_API_KEY=
# Legacy brand profile sync route.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# ---- Access while Huesy is a waitlist
# waitlist (default) lets only early access accounts into the app; open lets everyone in.
HUESY_ACCESS=waitlist
# Who gets into the app besides the QA account: emails or @domain rules, comma separated.
HUESY_EARLY_ACCESS=
# waitlist (default) or open: the public site's wording and calls to action.
NEXT_PUBLIC_HUESY_SITE=waitlist
# Per account daily AI allowance in dollars.
HUESY_DAILY_USD_CAP=3
# The most one search may spend before it stops continuing (default 0.6).
HUESY_SEARCH_USD_CAP=
# on shows Google sign in, once the Google provider is set up in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=
# QA only: 1 swaps every model call for the stand-in. Never set in production.
HUESY_AI_MOCK=
